---
layout: layouts/base.njk
---

<section class="home-hero">
  <h1 class="home-title">{{ metadata.title }}</h1>
  <p class="home-subtitle">{{ metadata.description }}</p>
</section>

<section class="home-grid">
  {% for post in collections.posts | reverse %}
    <a class="post-card" href="{{ post.url }}">
      <h2 class="post-card-title">{{ post.data.title }}</h2>
      <p class="post-card-meta">{{ post.date | date("MMMM d, yyyy") }}</p>
      {% if post.data.description %}
        <p class="post-card-excerpt">{{ post.data.description }}</p>
      {% endif %}
    </a>
  {% endfor %}
</section>

{{ content | safe }}
